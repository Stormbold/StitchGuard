{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stitchguard.dev/schemas/result.json",
  "title": "StitchGuard Compare Result",
  "type": "object",
  "required": [
    "version",
    "target",
    "actual",
    "score",
    "changedPixels",
    "changedRatio",
    "totalPixels",
    "status",
    "dimensions",
    "findings"
  ],
  "properties": {
    "version": { "type": "string" },
    "target": { "type": "string" },
    "actual": { "type": "string" },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "changedPixels": { "type": "integer", "minimum": 0 },
    "changedRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "totalPixels": { "type": "integer", "minimum": 0 },
    "status": {
      "type": "string",
      "enum": ["excellent", "acceptable", "needs_work", "fail"]
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "severity", "message", "confidence"],
        "properties": {
          "type": { "type": "string", "enum": ["layout", "color", "spacing"] },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "region": { "type": "string" },
          "message": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
