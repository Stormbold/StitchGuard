{
  "name": "stitchguard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Compare target design screenshots with implemented UI and generate agent repair prompts",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "pnpm --filter @stitchguard/cli dev",
    "stitchguard": "node packages/cli/dist/index.js",
    "generate-screenshots": "tsx scripts/generate-screenshots.ts",
    "generate-examples": "pnpm build && tsx scripts/generate-example-gallery.ts",
    "generate-zoo": "pnpm build && tsx scripts/generate-bad-ui-zoo.ts",
    "generate-all": "pnpm generate-examples && pnpm generate-zoo",
    "build:action": "pnpm build && node scripts/bundle-action.mjs",
    "demo:web": "pnpm --filter @stitchguard/web-demo dev",
    "build:demo": "pnpm --filter @stitchguard/web-demo build",
    "setup:browser": "playwright install chromium"
  },
  "keywords": ["visual-testing", "pixel-diff", "ai-agents", "codex", "cursor"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "esbuild": "^0.25.0"
  }
}
